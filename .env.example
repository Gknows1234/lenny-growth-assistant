# Safe local defaults. Copy to .env only when you need to override them.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

# The submitted demo defaults to native Ollama running on the Docker host.
# For a non-Docker Python run, change the URL to http://127.0.0.1:11434.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=180

# Optional cloud provider. The UI makes the active provider visible.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=180

# Optional Claude Agent SDK cloud provider. Never commit the real value.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=180

# Retrieval and context limits
RETRIEVAL_LIMIT=8
RETRIEVAL_CANDIDATES=30
MAX_CONTEXT_CHARS=24000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARS=12000

# Transcript refresh. 0 means all episodes.
TRANSCRIPT_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts.git
TRANSCRIPT_REF=main
INGEST_LIMIT=0
AUTO_INGEST=true

# Browser/API policy
ALLOWED_ORIGINS=http://localhost:8000
SESSION_USER_HEADER=X-User-Id
